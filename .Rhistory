library(httr)
library(jsonlite)
library(googlesheets4)
library(dplyr)
# --- CONFIGURATION ---
api_key <- "snXQrR0UIDeyca2bq7yzWPQTc4W8r6eK7AvIq6c7"
target_sheet_id <- "1qTIxS27TmyQYgkH2IJUVTikBBshRbnRVExXwAWM4ceo" # From the URL
# 1. PRE-CREATE THE VARIABLE (So it's never "not found")
all_comments <- data.frame()
# 2. RUN THE LOOP (Test with 3 pages first)
for (i in 1:3) {
message(paste("--- Fetching page", i, "---"))
url <- paste0("https://api.regulations.gov/v4/comments?",
"filter[searchTerm]=Dodd-Frank",
"&page[number]=", i,
"&page[size]=50",
"&api_key=", api_key)
resp <- GET(url)
# Check for API errors
if (status_code(resp) != 200) {
stop(paste("API Error:", status_code(resp), "- Check your API key!"))
}
# Parse the data
raw_content <- content(resp, as = "text", encoding = "UTF-8")
json_data <- fromJSON(raw_content)
# Extract the specific bits we want
page_df <- as.data.frame(json_data$data) %>%
mutate(
title = attributes$title,
posted_date = attributes$postedDate,
agency = attributes$agencyId
) %>%
select(id, title, posted_date, agency)
# ADD to our master list
all_comments <- bind_rows(all_comments, page_df)
}
message("SUCCESS: R now has ", nrow(all_comments), " rows in memory.")
# 3. PUSH TO GOOGLE SHEETS
# This will ask you to login in your browser if you haven't yet
gs4_auth()
