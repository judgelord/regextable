library(httr)
check_404_column <- function(url_vec, timeout_sec = 5) {
for (i in seq_along(url_vec)) {
u <- url_vec[i]
if (is.na(u) || nchar(u) < 10) next
res <- try(HEAD(u, timeout(timeout_sec)), silent = TRUE)
if (inherits(res, "try-error")) {
cat("ERROR:", i, u, "\n")
} else if (status_code(res) == 404) {
cat("404:", i, u, "\n")
}
}
}
data("cr2007_03_01")
print(cr2007_03_01$url)
print(check_404_column(cr2007_03_01$url))
