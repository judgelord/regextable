quarto::quarto_render("vignettes/native-tribes.qmd")
quarto::quarto_render("vignettes/native-tribes.qmd")
quarto::quarto_render("vignettes/native-tribes.qmd")
pkgdown::build_site()
quarto::quarto_render("vignettes/native-tribes.qmd")
quarto::quarto_render("vignettes/native-tribes.qmd")
pkgdown::build_site()
