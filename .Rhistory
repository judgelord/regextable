devtools::load_all()
# Example data frame
test_df <- data.frame(
id = 1:6,
text = c(
"Hello WORLD",
"Goodbye NASA",
"HELLO world",
"Other text",
"Hello Universe",
"Goodbye FBI"
),
date = as.Date(c("2025-01-01", "2025-02-15", "2025-03-10", "2025-04-05", "2025-05-20", "2025-06-15"))
)
# Example regex table
regex_table <- data.frame(
pattern = c("Hello", "World", "Universe", "NASA", "FBI"),
replacement = c("Hi", "Earth", "Galaxy", "Space Agency", "Federal Bureau"),
stringsAsFactors = FALSE
)
result_date <- apply_regextable_date(
test_df,
col_name = "text",
regex_table = regex_table,
date_start = "2025-02-01",
date_end = "2025-05-01"
)
print(result_date)
result_acronyms <- apply_regextable_acronyms(
test_df,
col_name = "text",
regex_table = regex_table,
remove_acronyms = TRUE
)
print(result_acronyms)
# Add an alternate pattern column
regex_table$pattern_alt <- tolower(regex_table$pattern)
result_pattern <- apply_regextable_pattern(
test_df,
col_name = "text",
regex_table = regex_table,
pattern = "pattern_alt"
)
print(result_pattern)
