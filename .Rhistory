library(httr)
library(jsonlite)
library(googlesheets4)
library(dplyr)
# --- CONFIGURATION ---
api_key <- "snXQrR0UIDeyca2bq7yzWPQTc4W8r6eK7AvIq6c7"
target_sheet_id <- "1qTIxS27TmyQYgkH2IJUVTikBBshRbnRVExXwAWM4ceo"
# 1. SETUP
all_comments <- data.frame()
total_results <- 10204
results_per_page <- 50
total_pages <- ceiling(total_results / results_per_page)
message(paste("Starting download of approx", total_pages, "pages..."))
# 2. THE BIG LOOP
# We loop from page 1 to 205 to get everything
for (i in 1:total_pages) {
# Print progress every page so you know it's not frozen
message(paste("Downloading page", i, "of", total_pages, "..."))
url <- paste0("https://api.regulations.gov/v4/comments?",
"filter[searchTerm]=Dodd-Frank",
"&page[number]=", i,
"&page[size]=", results_per_page,
"&api_key=", api_key)
# specific 'tryCatch' ensures one bad page doesn't crash the whole script
tryCatch({
resp <- GET(url)
if (status_code(resp) == 200) {
raw_content <- content(resp, as = "text", encoding = "UTF-8")
json_data <- fromJSON(raw_content)
# Extract data INCLUDING the comment text
if (length(json_data$data) > 0) {
page_df <- as.data.frame(json_data$data)
# We safely extract columns, filling with NA if missing
clean_df <- page_df %>%
mutate(
id = id,
# This is the column you were missing!
comment_text = if("comment" %in% names(attributes)) attributes$comment else NA,
title = attributes$title,
agency = attributes$agencyId,
posted_date = attributes$postedDate,
url = paste0("https://www.regulations.gov/comment/", id)
) %>%
select(id, title, comment_text, agency, posted_date, url)
all_comments <- bind_rows(all_comments, clean_df)
}
} else {
message(paste("Skipping page", i, "- API Error:", status_code(resp)))
}
}, error = function(e) {
message(paste("Error on page", i, ":", e$message))
})
# SLEEP for 1 second to be polite to the API (prevents banning)
Sys.sleep(1)
}
message("Download Complete! You have ", nrow(all_comments), " rows.")
# 3. PUSH TO GOOGLE SHEETS
message("Uploading to Google Sheets... (This might take a minute)")
gs4_auth()
head(all_comments)
library(httr)
library(jsonlite)
library(googlesheets4)
library(dplyr)
# --- CONFIGURATION ---
api_key <- "snXQrR0UIDeyca2bq7yzWPQTc4W8r6eK7AvIq6c7"
target_sheet_id <- "1qTIxS27TmyQYgkH2IJUVTikBBshRbnRVExXwAWM4ceo"
# 1. SETUP
all_comments <- data.frame()
# We cap this at 40 to avoid the 404 error (API limit is usually 2,000 results)
max_pages <- 40
message(paste("Starting download. Stopping at page", max_pages, "to avoid API limits."))
# 2. THE LOOP
for (i in 1:max_pages) {
message(paste("Downloading page", i, "of", max_pages, "..."))
url <- paste0("https://api.regulations.gov/v4/comments?",
"filter[searchTerm]=Dodd-Frank",
"&page[number]=", i,
"&page[size]=50",
"&api_key=", api_key)
tryCatch({
resp <- GET(url)
if (status_code(resp) == 200) {
json_data <- fromJSON(content(resp, as = "text", encoding = "UTF-8"))
# SAFE EXTRACTION LOGIC
if (length(json_data$data) > 0) {
# 1. Convert the main data to a frame
main_df <- as.data.frame(json_data$data)
# 2. Extract attributes as a separate frame
attrs <- main_df$attributes
# 3. Safely get the comment column (fill with NA if missing)
# This handles the case where a page has NO text comments
txt_col <- if("comment" %in% names(attrs)) attrs$comment else NA
# 4. Build the clean table
page_clean <- data.frame(
id = main_df$id,
posted_date = attrs$postedDate,
title = attrs$title,
# Use our safe column here
comment_text = txt_col,
agency = attrs$agencyId,
url = paste0("https://www.regulations.gov/comment/", main_df$id),
stringsAsFactors = FALSE
)
all_comments <- bind_rows(all_comments, page_clean)
}
} else {
message(paste("Page", i, "failed. Status:", status_code(resp)))
}
}, error = function(e) {
message(paste("Error on page", i, ":", e$message))
})
Sys.sleep(1)
}
message("Download Complete! You have ", nrow(all_comments), " rows.")
# 3. PUSH TO GOOGLE SHEETS
gs4_auth()
head(all_comments)
library(httr)
library(jsonlite)
library(googlesheets4)
library(dplyr)
# --- CONFIGURATION ---
api_key <- "snXQrR0UIDeyca2bq7yzWPQTc4W8r6eK7AvIq6c7"
target_sheet_id <- "1qTIxS27TmyQYgkH2IJUVTikBBshRbnRVExXwAWM4ceo"
# HOW MANY PAGES?
# Start with 2 pages (100 comments) to test.
# Change to 40 later if you have 30 minutes to wait.
max_pages_to_scan <- 2
all_comments <- data.frame()
message("--- STARTING DEEP DIVE ---")
# 1. LOOP THROUGH THE PAGES (The Lists)
for (page_i in 1:max_pages_to_scan) {
message(paste("Processing List Page", page_i, "of", max_pages_to_scan, "..."))
# A. Get the list of IDs for this page
list_url <- paste0("https://api.regulations.gov/v4/comments?",
"filter[searchTerm]=Dodd-Frank",
"&page[number]=", page_i,
"&page[size]=50",
"&api_key=", api_key)
resp <- GET(list_url)
if (status_code(resp) == 200) {
list_json <- fromJSON(content(resp, as = "text", encoding = "UTF-8"))
if (length(list_json$data) > 0) {
page_items <- list_json$data
# 2. LOOP THROUGH EACH ID (The Details)
# This is the "Nested Loop" that gets the actual text
for (row_idx in 1:nrow(page_items)) {
current_id <- page_items$id[row_idx]
current_title <- page_items$attributes$title[row_idx]
# Build the URL for the SPECIFIC comment
detail_url <- paste0("https://api.regulations.gov/v4/comments/", current_id,
"?include=attachments&api_key=", api_key)
# Fetch the detail
tryCatch({
detail_resp <- GET(detail_url)
if (status_code(detail_resp) == 200) {
detail_json <- fromJSON(content(detail_resp, as = "text", encoding = "UTF-8"))
# EXTRACT THE REAL TEXT
# If it's null (e.g. only an attachment), we use NA
full_text <- detail_json$data$attributes$comment
if (is.null(full_text)) full_text <- "NA (Likely PDF Attachment Only)"
# Add to our table
new_row <- data.frame(
id = current_id,
date = page_items$attributes$postedDate[row_idx],
title = current_title,
comment_body = full_text, # <--- THIS IS WHAT YOU WANTED
url = paste0("https://www.regulations.gov/comment/", current_id),
stringsAsFactors = FALSE
)
all_comments <- bind_rows(all_comments, new_row)
}
# IMPORTANT: We must sleep slightly to avoid "429 Too Many Requests"
# This is why it takes so long.
Sys.sleep(0.6)
}, error = function(e) { message(paste("Skipping", current_id, "- Error")) })
# Little progress indicator (prints a dot for every comment)
cat(".")
}
}
}
# New line after every page
cat("\n")
}
message(paste("Done! Collected", nrow(all_comments), "comments with full text."))
# 3. PUSH TO GOOGLE SHEETS
gs4_auth()
head(all_comments)
head(attrs)
as_tibble(head(attrs))
as_tibble(head(clean)df)
as_tibble(head(clean_df))
as_tibble(head(detail_resp))
