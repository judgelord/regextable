# Load required libraries
library(dplyr)
library(stringr)
# Example data frame
test_df <- data.frame(
id = 1:6,
text = c(
"Hello WORLD",
"Goodbye World",
"HELLO world",
"Other text",
"Hello Universe",
"Goodbye Universe"
),
date = as.Date(c("2025-01-01", "2025-02-15", "2025-03-10", "2025-04-05", "2025-05-20", "2025-06-15"))
)
# Example regex table
regex_table <- data.frame(
pattern = c("Hello", "World", "Universe"),
replacement = c("Hi", "Earth", "Galaxy"),
stringsAsFactors = FALSE
)
# Test 1: Apply function to all rows
result_all <- apply_regextable_date(test_df, col_name = "text", regex_table = regex_table)
print(result_all)
# Test 2: Apply function only to rows within a date range
result_filtered <- apply_regextable_date(
test_df,
col_name = "text",
regex_table = regex_table,
date_start = "2025-02-01",
date_end = "2025-05-01"
)
print(result_filtered)
rm(regex_table)
rm(result_all)
rm(Data)
rm(result_filtered)
rm(test_df)
